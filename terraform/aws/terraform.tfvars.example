# Copy to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored

aws_region    = "us-east-1"
environment   = "prod"
instance_type = "t3.xlarge"  # 4 vCPU / 16GB

root_volume_size_gb = 50
data_volume_size_gb = 200

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Required. Your own address range(s); 0.0.0.0/0 is refused.
allowed_ssh_cidrs = ["203.0.113.10/32"]

# Leave empty - use SSH tunnel for Airflow UI:
#   ssh -L 8080:localhost:8080 app@<elastic-ip>
airflow_ui_cidrs = []

availability_zone     = "us-east-1a" # must be in aws_region
backup_retention_days = 30
